# Скопируйте в .env при необходимости. Без .env сервис стартует на значениях по умолчанию.

# Порт интерфейса и API на хосте
WEB_PORT=8080
API_PORT=8000

# Каталог с выданным набором чипов (внутри лежат af/ и bs/)
DATA_PATH=./DATA/train

# Сколько сцен брать при первом запуске. 0 = все (420 AF + 224 BS)
SEED_LIMIT_AF=0
SEED_LIMIT_BS=0

# Параллельные воркеры конвейера
WORKER_REPLICAS=4

# ML-модели: "package.module:ClassName". Горение: LightGBM, гари: индексный baseline
FIRE_ML_AF=fire_ml.af_gbm:GbmActiveFire
FIRE_ML_BS=fire_ml.baseline:BaselineBurnSeverity

# Агент: любой OpenAI-совместимый endpoint (Ollama, vLLM, облачный API).
# Пусто = агент отвечает по правилам без языковой модели.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

POSTGRES_PASSWORD=firewatch
S3_ACCESS_KEY=firewatch
S3_SECRET_KEY=firewatch-secret
# Бесплатный ключ NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
